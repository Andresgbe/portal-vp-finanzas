# Copia este archivo como `.env` (en la raíz del proyecto) y completa los valores.
# El archivo .env está en .gitignore: nunca se sube al repositorio.

# Entorno: development | production
APP_ENV=development

# Base de datos. Local: SQLite (no requiere instalar nada).
# Producción: PostgreSQL, por ejemplo
#   postgresql+psycopg://USUARIO:CLAVE@HOST:5432/postgres
DATABASE_URL=sqlite:///./portal.db

# Clave para firmar los tokens de sesión (JWT). Debe ser larga y aleatoria.
# Genera una con:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Minutos que dura una sesión antes de pedir login otra vez
JWT_EXPIRE_MINUTES=60

# Contraseña que el script de semilla asigna a los usuarios de demostración.
# Solo para demo local; mínimo 10 caracteres.
SEED_DEMO_PASSWORD=

# true en producción (HTTPS). En local con http debe ser false.
COOKIE_SECURE=false
